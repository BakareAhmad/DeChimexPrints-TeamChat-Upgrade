@model DeChimex.Host.Models.Admin.AnnouncementFormViewModel
@{
    Layout = "_AdminLayout";
}
<div class="card" style="max-width:560px">
    <div class="card-head"><h3>Edit announcement</h3></div>
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" data-guard>
            @await Html.PartialAsync("_AnnouncementForm", Model)
            <div class="flex items-center gap-2 mt-4">
                <button class="btn btn-primary" type="submit">Save</button>
                <a class="btn btn-outline" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>
