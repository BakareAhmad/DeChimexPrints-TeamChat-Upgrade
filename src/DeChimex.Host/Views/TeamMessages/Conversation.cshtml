@model DeChimex.Contracts.InternalMessages.ConversationDetailDto
@{
    var dev = ViewBag.DevPortal is true;
    Layout = dev ? "~/Views/Dev/_DevLayout.cshtml" : "_AdminLayout";
    var base_ = ViewBag.TeamMessagesBase as string ?? (dev ? "/dev/messages" : "/admin/team-messages");
    var myUserId = ViewBag.MyUserId is Guid mid ? mid : Guid.Empty;
    string Fmt(DateTime utc) => utc.ToLocalTime().ToString("dd MMM yyyy HH:mm");
    string FmtTime(DateTime utc) => utc.ToLocalTime().ToString("HH:mm");
    string Size(long bytes) => bytes < 1024 ? $"{bytes} B" : bytes < 1024 * 1024
        ? $"{bytes / 1024d:0.#} KB" : $"{bytes / 1024d / 1024d:0.#} MB";
    string MediaLabel(string kind) => kind switch
    {
        "image" => "Photo",
        "video" => "Video",
        "voice" => "Voice note",
        "audio" => "Audio",
        _ => "Attachment"
    };
    string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2);
        return string.Concat(parts.Select(p => char.ToUpperInvariant(p[0])));
    }
}
<div class="team-chat-page"
     data-team-conversation="@Model.ConversationId"
     data-my-id="@myUserId"
     data-team-base="@base_"
     data-team-sync-url="@base_/@Model.ConversationId/messages"
     data-team-read-url="@base_/@Model.ConversationId/read"
     data-team-unread-url="@base_/unread-count">
    <header class="team-chat-header">
        <a class="team-back-link" href="@base_" aria-label="Back to all conversations">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6M9 12h12" /></svg>
            <span>Conversations</span>
        </a>
        <div class="team-chat-person">
            <span class="team-avatar" aria-hidden="true">@Initials(Model.OtherName)</span>
            <div class="team-chat-person-copy">
                <h1>@Model.OtherName</h1>
                <p>@Model.OtherRoleLabel <span class="team-header-dot" aria-hidden="true">·</span> Private work conversation</p>
            </div>
        </div>
        <span class="team-live-pill" data-team-live-status role="status" aria-live="polite">
            <span class="team-live-dot" aria-hidden="true"></span>
            <span data-team-live-label>Connecting…</span>
        </span>
    </header>

    <section class="team-chat-card" aria-label="Conversation with @Model.OtherName">
        <div class="team-message-scroll" data-team-messages-scroll>
            <ol class="team-message-list" data-team-messages-list role="log"
                aria-label="Messages with @Model.OtherName" aria-live="polite" aria-relevant="additions text">
                @if (Model.Messages.Count == 0)
                {
                    <li class="team-empty-state" data-team-empty>
                        <span class="team-empty-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8A8.5 8.5 0 0 1 8.7 3.9a8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8z" /></svg>
                        </span>
                        <strong>No messages yet</strong>
                        <span>Send a note or share a file to get the conversation started.</span>
                    </li>
                }
                @foreach (var m in Model.Messages)
                {
                    <li class="team-message @(m.IsMine ? "is-mine" : "is-theirs")"
                        data-team-msg="@m.Id"
                        data-sent-utc="@m.SentAtUtc.ToString("O")"
                        data-sender-id="@m.SenderId"
                        data-read-at="@(m.ReadAtUtc?.ToString("O") ?? "")"
                        data-client-message-id="@(m.ClientMessageId?.ToString() ?? "")">
                        <div class="team-bubble">
                            @if (!m.IsMine)
                            {
                                <div class="team-message-author">@m.SenderName</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(m.Body))
                            {
                                <p class="team-message-text">@m.Body</p>
                            }
                            @if (m.Attachments.Count > 0)
                            {
                                <div class="team-attachments">
                                    @foreach (var attachment in m.Attachments)
                                    {
                                        var label = MediaLabel(attachment.Kind);
                                        if (attachment.Kind == "image")
                                        {
                                            <a class="team-image-attachment" href="@attachment.Url" target="_blank" rel="noopener noreferrer" aria-label="Open image: @attachment.OriginalFileName">
                                                <img src="@attachment.Url" alt="@attachment.OriginalFileName" loading="lazy" decoding="async" />
                                            </a>
                                        }
                                        else if (attachment.Kind == "video")
                                        {
                                            <figure class="team-video-attachment">
                                                <video controls preload="metadata" playsinline aria-label="@label: @attachment.OriginalFileName">
                                                    <source src="@attachment.Url" type="@attachment.ContentType" />
                                                    Your browser does not support video playback.
                                                </video>
                                                <figcaption>@attachment.OriginalFileName</figcaption>
                                            </figure>
                                        }
                                        else if (attachment.Kind is "audio" or "voice")
                                        {
                                            <div class="team-audio-attachment">
                                                <span class="team-media-icon" aria-hidden="true">
                                                    <svg viewBox="0 0 24 24"><path d="M12 2a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z" /><path d="M19 10v1a7 7 0 0 1-14 0v-1M12 18v4m-4 0h8" /></svg>
                                                </span>
                                                <div class="team-audio-main">
                                                    <span class="team-audio-label">@label <span class="team-file-name">· @attachment.OriginalFileName</span></span>
                                                    <audio controls preload="none" aria-label="@label: @attachment.OriginalFileName">
                                                        <source src="@attachment.Url" type="@attachment.ContentType" />
                                                        Your browser does not support audio playback.
                                                    </audio>
                                                </div>
                                                @if (attachment.DurationSeconds is int seconds)
                                                {
                                                    <span class="team-audio-duration">@TimeSpan.FromSeconds(seconds).ToString(@"m\:ss")</span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <a class="team-file-attachment" href="@attachment.Url" target="_blank" rel="noopener noreferrer">
                                                <span class="team-media-icon" aria-hidden="true">
                                                    <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6M8 13h8M8 17h8" /></svg>
                                                </span>
                                                <span class="team-file-copy"><strong>@attachment.OriginalFileName</strong><small>@Size(attachment.SizeBytes)</small></span>
                                                <svg class="team-download-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" /></svg>
                                            </a>
                                        }
                                    }
                                </div>
                            }
                            <footer class="team-message-foot">
                                <time datetime="@m.SentAtUtc.ToString("O")" title="@Fmt(m.SentAtUtc)">@FmtTime(m.SentAtUtc)</time>
                                @if (m.IsMine)
                                {
                                    var readState = m.ReadAtUtc is null ? "sent" : "read";
                                    <span class="team-message-status is-@readState"
                                          data-team-read-state="@readState"
                                          aria-label="@(m.ReadAtUtc is null ? "Sent" : "Read")"
                                          title="@(m.ReadAtUtc is null ? "Sent" : "Read")">
                                        <svg viewBox="0 0 18 12" aria-hidden="true"><path d="m1 6 3.5 3.5L12 2" /><path d="m6 6 3.5 3.5L17 2" /></svg>
                                        <span>@(m.ReadAtUtc is null ? "Sent" : "Read")</span>
                                    </span>
                                }
                            </footer>
                        </div>
                    </li>
                }
            </ol>
        </div>

        <form class="team-composer" id="teamSendForm" method="post" action="@base_/@Model.ConversationId/send" enctype="multipart/form-data" data-team-send-form>
            @Html.AntiForgeryToken()
            <input type="hidden" name="clientMessageId" id="teamClientMessageId" value="@Guid.NewGuid()" />
            <div class="team-composer-top">
                <label class="visually-hidden" for="teamBody">Write a message</label>
                <textarea id="teamBody" name="body" rows="2" maxlength="@DeChimex.Domain.Entities.InternalMessage.MaxBodyLength"
                          placeholder="Write a message…" autocomplete="off" data-team-body></textarea>
            </div>
            <div class="team-stage-list" data-team-stage-list hidden></div>
            <div class="team-recording-bar" data-team-recording-bar hidden role="status" aria-live="polite">
                <span class="team-recording-pulse" aria-hidden="true"></span>
                <span>Recording</span>
                <time data-team-recording-time>0:00 / 5:00</time>
                <button type="button" class="team-small-button" data-team-record-stop>Stop</button>
                <button type="button" class="team-small-button is-quiet" data-team-record-cancel>Cancel</button>
            </div>
            <div class="team-voice-preview" data-team-voice-preview hidden>
                <span class="team-media-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M12 2a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z" /><path d="M19 10v1a7 7 0 0 1-14 0v-1M12 18v4m-4 0h8" /></svg>
                </span>
                <audio controls data-team-voice-audio aria-label="Recorded voice note preview"></audio>
                <span class="team-voice-caption">Voice note preview</span>
                <button type="button" class="team-small-button is-quiet" data-team-voice-discard>Discard</button>
            </div>
            <div class="team-composer-bottom">
                <div class="team-composer-tools">
                    <input type="file" name="files" id="teamFileInput" class="team-file-input" multiple
                           accept="image/*,video/*,audio/*,.pdf,.doc,.docx,.mp4,.webm,.ogg,.oga,.wav,.m4a" data-team-files />
                    <label class="team-icon-button" data-team-attach for="teamFileInput" tabindex="0" role="button"
                           aria-label="Attach photos, videos, audio or files" title="Attach files">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21.4 11.1-8.5 8.5a6 6 0 0 1-8.5-8.5l9.2-9.2a4 4 0 0 1 5.7 5.7l-9.2 9.2a2 2 0 0 1-2.8-2.8l8.5-8.5" /></svg>
                    </label>
                    <button type="button" class="team-icon-button" data-team-record aria-label="Record a voice note" title="Record a voice note">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z" /><path d="M19 10v1a7 7 0 0 1-14 0v-1M12 18v4m-4 0h8" /></svg>
                    </button>
                    <span class="team-composer-hint">Up to 6 files · 10 MB each</span>
                </div>
                <span class="team-character-count" data-team-character-count>0 / @DeChimex.Domain.Entities.InternalMessage.MaxBodyLength</span>
                <button type="submit" class="team-send-button" data-team-send>
                    <span>Send</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z" /><path d="M22 2 11 13" /></svg>
                </button>
            </div>
            <div class="team-upload-progress" data-team-upload-progress hidden aria-label="Upload progress"><span data-team-upload-fill></span></div>
            <div class="team-composer-error" data-team-error role="alert" hidden></div>
        </form>
    </section>
</div>
