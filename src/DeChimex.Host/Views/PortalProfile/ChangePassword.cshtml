@model DeChimex.Host.Models.Portal.ChangePasswordFormViewModel
@using DeChimex.Host
@{
    Layout = "_PortalLayout";
    ViewData["Title"] = "Change password";
    ViewData["ActiveNav"] = "profile";
}
<div class="cs-wrap cs-wrap-sm">
    <partial name="Customer/_BackLink" model="@("/portal/profile", "Profile", "margin-top:12px")" />
    <div class="cs-page-head"><h1>Change password</h1></div>
    <section class="cs-card cs-card-pad">
        @if (ViewBag.PasswordChanged is true)
        {
            <div class="alert alert-success mb-4" role="status">Password changed successfully.</div>
        }
        <form asp-action="ChangePassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-error mb-4" role="alert"></div>
            <div class="field">
                <label class="label" asp-for="CurrentPassword">Current password <span class="req">*</span></label>
                <div class="pw-wrap"><input class="input" asp-for="CurrentPassword" type="password" autocomplete="current-password" /><partial name="_PwToggle" /></div>
                <span asp-validation-for="CurrentPassword" class="field-error"></span>
            </div>
            <div class="field">
                <label class="label" asp-for="NewPassword">New password <span class="req">*</span></label>
                <div class="pw-wrap"><input class="input" asp-for="NewPassword" type="password" autocomplete="new-password" /><partial name="_PwToggle" /></div>
                <span asp-validation-for="NewPassword" class="field-error"></span>
            </div>
            <div class="field">
                <label class="label" asp-for="ConfirmPassword">Confirm new password <span class="req">*</span></label>
                <div class="pw-wrap"><input class="input" asp-for="ConfirmPassword" type="password" autocomplete="new-password" /><partial name="_PwToggle" /></div>
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>
            <button class="btn btn-primary btn-block" type="submit">Update password</button>
        </form>
    </section>
</div>
