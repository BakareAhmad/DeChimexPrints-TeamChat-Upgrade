@inject DeChimex.Host.Services.CustomerShellService Shell
@using DeChimex.Host
@{
    Layout = null;
    var title = ViewData["Title"] as string;
    var pageTitle = string.IsNullOrWhiteSpace(title) ? "DE-CHIMEX PRINT HUB" : $"{title} · DE-CHIMEX PRINT HUB";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#ffffff">
    <title>@pageTitle</title>
    <partial name="_BrandHead" />

    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/tailwind.build.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/customer.css" asp-append-version="true">
</head>
<body class="cs-body au-body">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="au-top">
        <a class="cs-back" href="/">@Html.Raw(CustomerIcons.Svg("arrow-left", 18)) Back to store</a>
        <a class="cs-brand" href="/" aria-label="DE-CHIMEX PRINT HUB home">
            <span class="cs-logo @(Shell.LogoUrl is null ? "is-text" : "")">@if (Shell.LogoUrl is not null) { <img src="@Shell.LogoUrl" alt="" width="52" height="52"> } else { <text>DC</text> }</span>
        </a>
    </header>
    <main id="main-content" class="au-main">
        <div class="au-card">
            @if (TempData["Info"] is string infoMsg && !string.IsNullOrWhiteSpace(infoMsg))
            {
                <div class="alert alert-info mb-4" role="status">@infoMsg</div>
            }
            @if (TempData["Success"] is string okMsg && !string.IsNullOrWhiteSpace(okMsg))
            {
                <div class="alert alert-success mb-4" role="status">@okMsg</div>
            }
            @if (TempData["Error"] is string errMsg && !string.IsNullOrWhiteSpace(errMsg))
            {
                <div class="alert alert-error mb-4" role="alert">@errMsg</div>
            }
            @RenderBody()
        </div>
    </main>
    <script src="~/js/password-toggle.js" asp-append-version="true" defer></script>
    <script src="~/js/back-link.js" asp-append-version="true" defer></script>
    <script src="~/js/form-guard.js" asp-append-version="true" defer></script>
    <script src="~/js/customer-shell.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
